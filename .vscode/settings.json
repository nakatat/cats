{
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "always",
        "source.organizeImports": "never"
    },
    "eslint.format.enable": false,
    "eslint.codeActionsOnSave.mode": "all",
    "eslint.workingDirectories": [{ "mode": "auto" }],
    "eslint.validate": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact"
    ],
    "files.associations": {
        "*.css": "tailwindcss"
    },
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.detectIndentation": false,
    "java.compile.nullAnalysis.mode": "automatic",
    "java.autobuild.enabled": true,
    "[java]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4
    },
    "cSpell.words": [
        "autobuild",
        "autodocs",
        "baseballscore",
        "battingaverage",
        "battingline",
        "bradlc",
        "CHOKIDAR",
        "dbaeumer",
        "diffplug",
        "Dmaven",
        "Dskip",
        "esbenp",
        "esbuild",
        "flywaydb",
        "gameparticipant",
        "hamcrest",
        "healthcheck",
        "hikari",
        "Hiragino",
        "homeruns",
        "isready",
        "javax",
        "Kaku",
        "keepalive",
        "libc",
        "linecorp",
        "livereload",
        "logback",
        "Meiryo",
        "mockmvc",
        "mybatis",
        "Noto",
        "nums",
        "oklch",
        "pitchingline",
        "projectlombok",
        "runsbattedin",
        "Scroller",
        "shinkotoni",
        "springdoc",
        "Supabase",
        "teamsummary",
        "temurin",
        "unrs",
        "USEPOLLING",
        "varchar",
        "vscjava",
        "WATCHPACK",
        "webmvc",
        "wordmark"
    ],
    "java.configuration.updateBuildConfiguration": "automatic",
    "[dockercompose]": {
        "editor.defaultFormatter": "ms-azuretools.vscode-containers"
    }
}
