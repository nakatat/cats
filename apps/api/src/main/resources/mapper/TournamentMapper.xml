<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="dev.baseballscore.cats.api.tournament.mapper.TournamentMapper">

    <resultMap id="TournamentRowMap" type="dev.baseballscore.cats.api.tournament.mapper.model.TournamentRow">
        <id column="id" property="id"/>
        <result column="team_id" property="teamId"/>
        <result column="name" property="name"/>
        <result column="short_name" property="shortName"/>
        <result column="season_year" property="seasonYear"/>
        <result column="description" property="description"/>
        <result column="display_order" property="displayOrder"/>
    </resultMap>

    <select id="findTournamentsByTeamId" resultMap="TournamentRowMap">
        SELECT
            id,
            team_id,
            name,
            short_name,
            season_year,
            description,
            display_order
        FROM tournaments
        WHERE team_id = #{teamId}
        ORDER BY display_order ASC, season_year DESC NULLS LAST, id ASC
    </select>

    <select id="findTournamentByTeamIdAndTournamentId" resultMap="TournamentRowMap">
        SELECT
            id,
            team_id,
            name,
            short_name,
            season_year,
            description,
            display_order
        FROM tournaments
        WHERE team_id = #{teamId}
          AND id = #{tournamentId}
    </select>
</mapper>
